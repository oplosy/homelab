# Managed by SecureEdge (role app_service). No service publishes a port;
# secrets are interpolated from the root-only .env next to this file.
name: {{ app_service_project }}

services:
  postgres:
    image: {{ app_service_postgres_image }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      PGDATA: /var/lib/postgresql/18/docker
    volumes:
      - {{ app_service_root }}/postgres:/var/lib/postgresql
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: [CMD-SHELL, 'pg_isready -U "$${POSTGRES_USER}" -d "$${POSTGRES_DB}"']
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 10s

  garage:
    image: {{ app_service_garage_image }}
    restart: unless-stopped
    command: [/garage, server, --single-node, --default-bucket, --default-access-key]
    environment:
      GARAGE_DEFAULT_ACCESS_KEY: ${GARAGE_ACCESS_KEY}
      GARAGE_DEFAULT_SECRET_KEY: ${GARAGE_SECRET_KEY}
      GARAGE_DEFAULT_BUCKET: ${GARAGE_BUCKET}
      GARAGE_RPC_SECRET: ${GARAGE_RPC_SECRET}
    volumes:
      - {{ app_service_config_dir }}/garage.toml:/etc/garage.toml:ro
      - {{ app_service_root }}/garage/meta:/var/lib/garage/meta
      - {{ app_service_root }}/garage/data:/var/lib/garage/data
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: [CMD, /garage, status]
      interval: 5s
      timeout: 10s
      retries: 12
      start_period: 15s
{% if app_service_release | length > 0 %}
{%   set upstream = secureedge_app.upstream %}

  # The AtlasRisk release. Ansible runs `migrate` before (re)starting the
  # API and worker; `up` never starts it.
  migrate:
    image: {{ app_service_release.api_image }}
    profiles: [migrate]
    command: [migrate]
    environment:
      ATLASRISK_DATABASE_URL: ${ATLASRISK_DATABASE_URL}
    depends_on:
      postgres:
        condition: service_healthy
    read_only: true
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true

  # The only published port, and only on the WireGuard address: the edge
  # proxy is its sole client.
  api:
    image: {{ app_service_release.api_image }}
    restart: unless-stopped
    command: [-listen, "0.0.0.0:{{ upstream.port }}"]
    environment:
      ATLASRISK_DATABASE_URL: ${ATLASRISK_DATABASE_URL}
      ATLASRISK_S3_ENDPOINT: http://garage:3900
      ATLASRISK_S3_REGION: garage
      ATLASRISK_S3_BUCKET: ${GARAGE_BUCKET}
      AWS_ACCESS_KEY_ID: ${GARAGE_ACCESS_KEY}
      AWS_SECRET_ACCESS_KEY: ${GARAGE_SECRET_KEY}
    ports:
      - "{{ upstream.address }}:{{ upstream.port }}:{{ upstream.port }}"
    depends_on:
      postgres:
        condition: service_healthy
      garage:
        condition: service_healthy
    read_only: true
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true

  worker:
    image: {{ app_service_release.worker_image }}
    restart: unless-stopped
    environment:
      ATLASRISK_DATABASE_URL: ${ATLASRISK_DATABASE_URL}
    depends_on:
      postgres:
        condition: service_healthy
    read_only: true
    cap_drop: [ALL]
    security_opt:
      - no-new-privileges:true
    # The worker finishes its current job on SIGTERM.
    stop_grace_period: 2m
{% endif %}
